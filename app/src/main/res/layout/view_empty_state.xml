<?xml version="1.0" encoding="utf-8"?>
<!-- Estado vacío: ícono, título y una línea de ayuda. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingTop="24dp"
    android:paddingEnd="32dp"
    android:paddingBottom="96dp">

    <ImageView
        android:id="@+id/ivVacio"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_avatar"
        android:importantForAccessibility="no"
        android:scaleType="center"
        android:src="@drawable/ic_inbox"
        app:tint="@color/ink_secondary" />

    <TextView
        android:id="@+id/tvVacioTitulo"
        style="@style/Text.ClienTrack.RowTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvVacioTexto"
        style="@style/Text.ClienTrack.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center" />
</LinearLayout>
