<?xml version="1.0" encoding="utf-8"?>
<!-- Vista 4a: Formulario para crear o editar un caso -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/cd_volver"
        app:navigationIcon="@drawable/ic_arrow_back" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="8dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <!-- Cliente -->
            <TextView
                style="@style/Text.ClienTrack.FieldLabel"
                android:labelFor="@+id/actCliente"
                android:text="@string/label_client" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCliente"
                style="@style/Widget.ClienTrack.Input.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/actCliente"
                    style="@style/Widget.ClienTrack.DropdownText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Asunto -->
            <TextView
                style="@style/Text.ClienTrack.FieldLabel"
                android:layout_marginTop="18dp"
                android:labelFor="@+id/etAsunto"
                android:text="@string/label_subject" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilAsunto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:counterEnabled="true"
                app:counterMaxLength="80">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAsunto"
                    style="@style/Widget.ClienTrack.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_subject"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:maxLength="80"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Descripción (opcional) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.ClienTrack.FieldLabel"
                    android:labelFor="@+id/etDescripcion"
                    android:text="@string/label_description" />

                <TextView
                    style="@style/Text.ClienTrack.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/label_optional" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDescripcion"
                    style="@style/Widget.ClienTrack.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:hint="@string/hint_description"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="500"
                    android:minLines="3"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Prioridad -->
            <TextView
                style="@style/Text.ClienTrack.FieldLabel"
                android:layout_marginTop="18dp"
                android:text="@string/label_priority" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tgPrioridad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:checkedButton="@+id/btnPrioMedia"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrioAlta"
                    style="@style/Widget.ClienTrack.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/prioridad_alta" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrioMedia"
                    style="@style/Widget.ClienTrack.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/prioridad_media" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrioBaja"
                    style="@style/Widget.ClienTrack.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/prioridad_baja" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Estado -->
            <TextView
                style="@style/Text.ClienTrack.FieldLabel"
                android:layout_marginTop="18dp"
                android:text="@string/label_status" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tgEstado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:checkedButton="@+id/btnEstAbierto"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEstAbierto"
                    style="@style/Widget.ClienTrack.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/estado_abierto" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEstProceso"
                    style="@style/Widget.ClienTrack.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/estado_proceso" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEstCerrado"
                    style="@style/Widget.ClienTrack.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/estado_cerrado" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Fecha límite (se elige con un calendario) -->
            <TextView
                style="@style/Text.ClienTrack.FieldLabel"
                android:layout_marginTop="18dp"
                android:labelFor="@+id/etFecha"
                android:text="@string/label_due_date" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilFecha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:endIconContentDescription="@string/date_picker_title"
                app:endIconDrawable="@drawable/ic_calendar"
                app:endIconMode="custom">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFecha"
                    style="@style/Widget.ClienTrack.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:hint="@string/hint_due_date"
                    android:importantForAutofill="no"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Acción principal fija al pie -->
    <View style="@style/Widget.ClienTrack.Divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_case" />
    </LinearLayout>
</LinearLayout>
